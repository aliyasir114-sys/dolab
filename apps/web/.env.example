# The DOLAB API, as the browser reaches it (also used by the session routes unless DOLAB_API_URL is set).
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# The API as the web server reaches it, if different (e.g. an internal address).
# DOLAB_API_URL=http://api:8000/v1
# The site's public origin, for the session routes' same-origin check behind a proxy.
# DOLAB_WEB_ORIGIN=https://dolab.example
