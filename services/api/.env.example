# Copy to .env and fill in. Never commit the real .env file.
DOLAB_ENV=development
# SQLite for local development; PostgreSQL in production, e.g.
# DOLAB_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/dolab
DOLAB_DATABASE_URL=sqlite:///./dolab.db
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOLAB_JWT_SECRET=
# Access token lifetime in minutes; clients renew it with the refresh token
DOLAB_TOKEN_MINUTES=15
# How long a sign-in lasts without use, in days
DOLAB_REFRESH_DAYS=30
# How long a password-reset code works, in minutes
DOLAB_RESET_MINUTES=30
# Where photo files are stored (local disk for now) and the upload size limit in bytes
DOLAB_MEDIA_DIR=./media
DOLAB_MAX_UPLOAD_BYTES=8388608
# How long a signed photo link works, in seconds
DOLAB_MEDIA_URL_SECONDS=600
# Exact browser origins allowed to call the API, comma separated (no wildcard). Empty = no CORS.
DOLAB_CORS_ORIGINS=
# Number of trusted reverse proxies in front of the API (0 = use the socket address).
# Must match the deployment exactly; too high lets clients spoof their address.
DOLAB_TRUSTED_PROXY_HOPS=0
